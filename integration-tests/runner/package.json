{
  "name": "civs-integration-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous integration-test runner for Civs on a real Paper server (RCON + optional Mineflayer actor, JUnit XML output).",
  "type": "commonjs",
  "bin": {
    "civs-itest": "run.js"
  },
  "scripts": {
    "test": "node run.js",
    "test:one": "node run.js --scenario",
    "test:unit": "node --test test/*.test.js",
    "test:stream-unit": "node --test test/stream-planner.test.js",
    "test:otel-validate": "node scripts/validate-otel-tree.js",
    "village-builder": "node scripts/village-builder.js",
    "village-builder:once": "node scripts/village-builder.js --once",
    "village-watch": "node scripts/village-watch.js",
    "village-worker": "node scripts/village-worker.js",
    "test:village-unit": "node --test test/village-jobs.test.js",
    "test:observation-unit": "node --test test/observation-director.test.js test/cinematic.test.js",
    "test:nightshift-unit": "node --test test/cinematic.test.js test/director-fsm.test.js test/metrics.test.js test/motion.test.js test/survival.test.js test/focus.test.js test/consult-and-money.test.js test/terrain.test.js test/neural-policy.test.js",
    "observe-e2e": "node scripts/observe-e2e.js",
    "aiworld:train": "node scripts/aiworld-train.js",
    "aiworld:train:steve": "node scripts/aiworld-train.js --agent Steve",
    "aiworld:train:alex": "node scripts/aiworld-train.js --agent Alex",
    "test:ai-world-unit": "node --test test/ai-world.test.js",
    "test:construction-unit": "node --test test/construction-quality.test.js",
    "analyze-worker-log": "node scripts/analyze-worker-log.js",
    "construction-scenarios": "node scripts/construction-scenarios.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "knip": "knip --reporter compact",
    "arch": "depcruise lib scripts --config .dependency-cruiser.cjs --validate",
    "commitlint": "commitlint --edit",
    "test:mutation": "stryker run",
    "test:mutation:dsl": "stryker run --mutate lib/dsl.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^1.30.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "minecraft-protocol": "^1.66.2",
    "rcon-client": "^4.2.5",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "mineflayer": "^4.37.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@stryker-mutator/core": "^8.7.1",
    "dependency-cruiser": "^16.10.2",
    "knip": "^5.61.3",
    "typescript": "^5.8.3"
  }
}
